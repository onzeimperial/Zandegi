# ─────────────────────────────────────────────────────────────
#  ZANDEGI — environment configuration
#  Copy this file to `.env` and fill in the values.
#  NEVER commit `.env`. NEVER put secrets in client code.
# ─────────────────────────────────────────────────────────────

# --- Database -------------------------------------------------
# Local development (zero-setup): SQLite file.
DATABASE_URL="file:./dev.db"
#
# Production (recommended): PostgreSQL. To switch:
#   1. Set the provider in prisma/schema.prisma to "postgresql"
#   2. Use a URL like the one below
#   3. Re-run: npm run db:migrate
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zandegi?schema=public"

# --- Auth (Auth.js / NextAuth v5) ---------------------------
# Generate one with:  npx auth secret   (or) openssl rand -base64 32
AUTH_SECRET="a08a27d38f694ba19ad3164281d433e07c87e49e32b5b97ff9d1b7b46852d85e"
# Base URL of the app. Required in production.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Optional OAuth providers. Leave blank to disable that provider.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- AI (Anthropic) ----------------------------------------
# Required for live AI goal decomposition + coaching.
# Without it, Zandegi falls back to a deterministic rules-based planner
# (fully functional, clearly labelled as "heuristic" in the UI).
ANTHROPIC_API_KEY=""
# Model ids: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5-20251001
ZANDEGI_AI_MODEL="claude-sonnet-5"
ZANDEGI_AI_MODEL_FAST="claude-haiku-4-5-20251001"
# Hard cap on AI tokens per request (cost guard).
ZANDEGI_AI_MAX_TOKENS="4096"

# --- Knowledge retrieval (optional) ------------------------
# Used by the versioned knowledge system to refresh real-world facts
# (e.g. exam formats). Optional; knowledge falls back to seeded entries.
ZANDEGI_KNOWLEDGE_SEARCH_API_KEY=""

# --- App config -------------------------------------------
NODE_ENV="development"
# Comma-separated origins allowed to call the API (CSRF hardening).
ZANDEGI_ALLOWED_ORIGINS="http://localhost:3000"
# Requests per minute per user for AI endpoints.
ZANDEGI_AI_RATE_LIMIT="20"