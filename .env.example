# ─────────────────────────────────────────────────────────────
#  ZANDEGI — environment configuration
#  Copy this file to `.env` and fill in the values.
#  NEVER commit `.env`. NEVER put secrets in client code.
# ─────────────────────────────────────────────────────────────

# --- Database (Postgres on Neon) -----------------------------
# The durable store. Blank means the in-memory store in development; production
# refuses to run without it. Use Neon's pooled connection string.
DATABASE_URL=""
# Neon's direct connection string. Migrations use it when set, because they
# should not go through the pooler.
DATABASE_URL_UNPOOLED=""

# --- Sign-in (Clerk) ------------------------------------------
# Both keys mean sign-in is on. Neither means guest mode, outside production only.
# Production with no keys or no allowlist serves nothing.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Comma-separated emails who may use the app. A match needs a verified address.
ZANDEGI_ALLOWED_EMAILS=""
# Mission builds per person per UTC day. Blank = 5. Protects the Anthropic budget.
ZANDEGI_DAILY_GENERATION_LIMIT=""

# --- AI (Anthropic) ----------------------------------------
# Required for live AI goal decomposition + coaching.
# Without it, Zandegi falls back to a deterministic rules-based planner
# (fully functional, clearly labelled as "heuristic" in the UI).
ANTHROPIC_API_KEY=""
# Model ids: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5-20251001
ZANDEGI_AI_MODEL="claude-sonnet-5"
ZANDEGI_AI_MODEL_FAST="claude-haiku-4-5-20251001"
# Hard cap on AI tokens per request (cost guard).
ZANDEGI_AI_MAX_TOKENS="4096"

# --- Knowledge retrieval (optional) ------------------------
# Used by the versioned knowledge system to refresh real-world facts
# (e.g. exam formats). Optional; knowledge falls back to seeded entries.
ZANDEGI_KNOWLEDGE_SEARCH_API_KEY=""

# --- App config -------------------------------------------
NODE_ENV="development"
# Comma-separated extra origins allowed to call the API (CSRF hardening).
# A mutating request whose Origin matches neither the app's own origin nor this
# list is rejected before the body is read.
#
# On Vercel the app's own origin is taken from X-Forwarded-Host, which the
# platform sets, so a normal deployment needs nothing here. This list is for the
# cases that remain: a custom domain fronting a different host, or a second
# origin you want to allow deliberately.
#
# Off the platform, forwarded headers are ignored entirely -- a caller can send
# them, so trusting them would be a CSRF bypass.
ZANDEGI_ALLOWED_ORIGINS=""
# Where generation incidents are appended as JSONL. Development defaults to
# apps/web/logs/generation-incidents.jsonl; hosted deployments rely on platform
# logs unless this is set. Read it with: pnpm incidents
ZANDEGI_INCIDENT_LOG=""
# Requests per minute per user for AI endpoints.
ZANDEGI_AI_RATE_LIMIT="20"
# --- Store selection and guest mode ---------------------------
# "postgres", "redis" or "memory". Blank infers: postgres when DATABASE_URL is a
# postgres URL, redis when both Upstash values below are set, memory otherwise.
# Production refuses memory, and uses redis only if it is named here.
ZANDEGI_MISSION_STORE=""
# Days of inactivity before a guest and their missions expire, for the memory and
# redis stores. Blank = 30. Postgres records do not expire.
ZANDEGI_GUEST_RETENTION_DAYS=""
# Upstash Redis Global with a Sydney primary (AD-11). Never commit these.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
