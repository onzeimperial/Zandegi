// Relational state for the two-person test. Prisma types never leave @zandegi/db
// (AD-2): the rest of the system sees the DemoStore interface.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A person, identified either by a guest token hash or by a Clerk user.
model Principal {
  id          String   @id
  tokenHash   String?  @unique
  clerkUserId String?  @unique
  createdAt   DateTime @db.Timestamptz(3)

  missions Mission[]
  claims   CompletionClaim[]
  ledger   LedgerEntry[]
  usage    GenerationUsage[]
  logs     MissionLog[]
  reminder ReminderPreference?
}

/// An accepted mission. Personal content lives here, where it can be deleted.
model Mission {
  id          String   @id
  ownerId     String
  runId       String
  generatedAt DateTime @db.Timestamptz(3)
  goalText    String
  pursuitSlug String
  mission     Json
  safetyClass String
  goalContext Json?
  /// Bumped by every saved plan edit; an edit is a compare-and-set on it.
  version     Int      @default(0)

  owner Principal    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  logs  MissionLog[]

  @@index([ownerId, generatedAt(sort: Desc)])
}

/// Progress the plan did not foresee. Personal content, never a ledger fact, so it may be moved.
model MissionLog {
  id        String   @id
  ownerId   String
  missionId String
  chapterId String
  kind      String
  text      String?
  value     Float?
  unit      String?
  loggedAt  DateTime @db.Timestamptz(3)

  owner   Principal @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  mission Mission   @relation(fields: [missionId], references: [id], onDelete: Restrict)

  @@index([ownerId, missionId, loggedAt(sort: Desc)])
}

/// The atomic marker that one step has been paid. Removed if the append fails.
model CompletionClaim {
  ownerId      String
  completionId String
  claimedAt    DateTime @default(now()) @db.Timestamptz(3)

  owner Principal @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@id([ownerId, completionId])
}

/// Append-only (law 4). Database triggers reject UPDATE, DELETE and TRUNCATE; see the migration.
model LedgerEntry {
  position   BigInt   @id @default(autoincrement())
  ownerId    String
  entry      Json
  recordedAt DateTime @default(now()) @db.Timestamptz(3)

  owner Principal @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, position])
}

/// One person's generations in one UTC day. Spend protection, not progression.
model GenerationUsage {
  principalId String
  day         String
  count       Int

  principal Principal @relation(fields: [principalId], references: [id], onDelete: Restrict)

  @@id([principalId, day])
}

/// One person's daily reminder. The address is cleared when they turn it off; the last day stays.
model ReminderPreference {
  ownerId     String   @id
  email       String?
  timezone    String?
  updatedAt   DateTime @db.Timestamptz(3)
  lastSentDay String?

  owner Principal @relation(fields: [ownerId], references: [id], onDelete: Restrict)
}
