{
  "name": "zandegi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.8.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @zandegi/web dev",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify:current": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:legacy": "npm --prefix legacy run typecheck && npm --prefix legacy test",
    "verify": "pnpm verify:current && pnpm verify:legacy"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "2.1.9"
  }
}
