{
  "name": "zandegi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "12.8.2"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @zandegi/web dev",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tooling.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write . \"!_bmad/**\"",
    "format:check": "prettier --check . \"!_bmad/**\"",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "verify:legacy": "npm --prefix legacy run typecheck && npm --prefix legacy test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "2.1.9"
  }
}
